# Dependencies
**/node_modules
.pnpm-store/

# Build outputs
dist/
build/
*.dist

# Environment variables
# Every env file, not five named ones. .env.remote-backup sat untracked in the
# primary checkout for weeks, matching none of the five, one `git add -A`
# away from this public repo. Add exceptions below rather than dropping the
# glob.
.env*
!.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Amora runtime data (server state; volume-mounted in production).
# Seed sources live in server/seeds/ instead, NOT here — a data volume mount
# shadows anything the Docker image had at this path, so seeds must ship
# outside it to survive.
data/*

# Avatar generation bases. These are the full-size PNGs each class portrait is
# generated from; the tone variants are edits of them, so a resumed run needs
# the same file the first run made. Big, local, and reproducible from the
# manifest plus the prompts in scripts/gen_avatars.py.
scripts/avatar-bases/

# local scratch/handoff artifacts
atsc.txt
do_commit.bat
do_audit_commit.bat
DEPLOY_HANDOFF_2026-07-04.md
.qa-db-url
.demo-db-url

# Where the map QA suites write their scene export. env.sh derives this from
# its own location, so EVERY lane running the suites generates one of these in
# its own tree. Untracked and unignored is the combination that gets swept into
# somebody's `git add .`, which is how another lane's in-flight work has been
# committed under the wrong message before.
docs/prototypes/.qa-out/
# The staged control for paired_reps.sh: a 5.5 MB copy of the artifact under a
# git ref, plus the qa/ shell it has to be framed by. qa/README.md now tells you
# to make it, so it needs a line here for the same reason .qa-out does.
docs/prototypes/.qa-ctrl/

# The nightly rehearsal writes its runs here (scripts/rehearsal, docs/REHEARSAL.md).
.rehearsal/
