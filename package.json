{
  "name": "village-os",
  "version": "1.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/build-client-manifest.mjs && node scripts/build-server.mjs && node scripts/build-i18n-catalogs.mjs",
    "i18n:extract": "lingui extract",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:full": "node scripts/test-full.mjs",
    "test:unit": "vitest run --exclude \"**/*.e2e.test.ts\"",
    "test:watch": "vitest",
    "audit:fork-env": "node scripts/fork-env-audit.mjs",
    "measure:provisioning": "tsx scripts/measure-provisioning.mjs",
    "db:migrate": "tsx scripts/run-migration.ts --all",
    "db:status": "tsx scripts/run-migration.ts --status",
    "db:import": "tsx scripts/import-json-to-mysql.ts",
    "dev:server": "tsx watch --clear-screen=false server/index.ts"
  },
  "dependencies": {
