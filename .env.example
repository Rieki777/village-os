# Environment variables for a village running on this platform.
#
# (This line used to name one village's repository, which made the first
# sentence a founder reads somebody else's. The brand guard cannot catch it:
# it only scans .ts, .tsx, .js, .jsx, .mjs, .sql, .css, .html and .json, and
# this file is none of those. `node scripts/fork-env-audit.mjs` now checks
# this file for both problems, the naming and the drift below.)
#
# This file names every variable the server reads. Copy it to `.env` for
# local development (the server loads `.env` automatically). With
# docker-compose.yml on one machine, `.env` IS the configuration: the compose
# file reads it and hands it to the app. On a host like Railway, these values
# go into the host's own Variables tab, never into a checked-in file. See
# START_HERE.md for the walkthrough, docs/PROVISIONING.md for the hosted path,
# and docs/FORK_RUNBOOK.md for the long-form reasoning behind each one.
#
# `node scripts/fork-init.mjs` writes a filled-in `.env` for you: it
# generates the secrets on this list, fills in what you tell it about your
# village, and prints exactly which of the rest still need a human step.
#
# Your village's NAME, TAGLINE, COLOURS, LOGO and DOMAIN are not set here.
# Those live in the database and are set from Admin, Make This Yours, after
# your first login. This file only carries what the server needs before it
# can boot at all.

# ── REQUIRED: the server will not start, or nobody can ever log in, without these ──

# The MySQL connection string. On Railway this is a reference to your MySQL
# service, filled in automatically once you add one. Locally it points at
# your own database. Without it, the server refuses to start.
DATABASE_URL=

# Signs every member's session token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, the server makes up a new one on every restart, which logs out
# every member every time it restarts.
AUTH_TOKEN_SECRET=

# The one-time password you type on your village's /claim page to create
# the founder account (the page posts it to POST /api/admin/bootstrap). Pick
# anything long; you use it once, then it stops working for everyone except
# BREAK_GLASS_ADMIN_EMAIL. Without it, nobody can ever become an admin.
ADMIN_PASSWORD=

# This village's own public web address, e.g. https://rionuevo.example.org.
# Without it, no cross-site browser request is allowed, and every link in
# an outgoing email (claim links, digests) falls back to whatever address
# the server happened to be reached at that moment.
FRONTEND_URL=

# ── STRONGLY RECOMMENDED: the platform runs without these, but important paths are closed ──

# The one email address that can always re-claim admin, even if every admin
# account gets demoted or locked out. Usually your own email. Without it,
# a village that loses every admin has no way back in.
BREAK_GLASS_ADMIN_EMAIL=

# 32 random bytes as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts each member's own AI key and their agent-inbox signing secret.
# Without it, members cannot store either, and both features say so plainly
# rather than failing quietly. Rotating this key makes every stored member
# key unreadable, so set it once at provisioning and do not change it later.
MEMBER_SECRETS_KEY=

# 32 random bytes as 64 hex characters, its own value, never a copy of
# MEMBER_SECRETS_KEY. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts the village's own third-party keys where they are stored: your
# Stripe secret key, your Stripe and Riverside webhook secrets, your Resend
# and Anthropic keys. Without it, Admin, Integrations refuses every save
# with "this deployment has no village-secrets key", so no key can be set
# from the panel at all and every one of them has to come from this file
# instead. Clearing a key still works without it. Rotating it makes every
# key already stored through the panel unreadable, so set it once at
# provisioning and do not change it later.
VILLAGE_SECRETS_KEY=

# The "From:" address on every email this village sends, e.g.
# "Rio Nuevo <hello@rionuevo.example.org>". Must be on a domain you have
# verified in Resend (see RESEND_API_KEY below). Without it, mail goes out
# under the platform's own fallback sender address instead of yours.
EMAIL_FROM=

# Turns on outgoing email at all: claim links, notifications, digests.
# Get a key at resend.com. Without it, every email is silently skipped
# (logged, never sent) and the platform never says so out loud.
#
# TRAP: Resend answers HTTP 200 for a sender domain you have not verified,
# and delivers nothing. Verify your domain at resend.com/domains (it walks
# you through the SPF + DKIM records) before you trust that any email is
# actually arriving. This can be settable from Admin, Integrations instead
# of here; either way, verify the domain first.
RESEND_API_KEY=

# The signing secret of your email provider's delivery-report webhook, in the
# form whsec_... . Reports tell the village which emails were delivered, which
# bounced and which were marked as spam. Comms Settings in Admin can create the
# webhook and store this for you; set it here only if you made the webhook by
# hand. Without it every report is refused, and an address that bounced keeps
# being written to.
RESEND_WEBHOOK_SECRET=

# How many proxies sit in front of this server. Every rate limit (sign-in
# throttling, checkout attempts, the abuse guard) is keyed on the address
# this number finds. 1 is correct on Railway. Too low trusts a forged
# header and lets one caller dodge every limit; too high buckets unrelated
# visitors together and throttles innocent people.
TRUSTED_PROXY_HOPS=1

# ── GOOGLE SIGN-IN: optional, an extra door beside email and password ──
#
# Leave these blank and nothing breaks. The sign-in page shows no Google
# button at all, and members sign in with email and password as they always
# have. The server prints which sign-in methods it has on every boot, so
# check the log after a deploy if you expected a button and see none.
#
# WHY EACH VILLAGE SETS ITS OWN. Google checks the callback address against a
# list you register, so the credentials belong to whoever owns that list.
# Two ways to get them, and the code is identical either way:
#
#   1. Create your own OAuth client. About ten minutes, once, and your
#      village owns its own credentials. Steps: docs/GOOGLE_SIGN_IN.md.
#   2. Ask ReGen Civics to add your callback address to the shared client
#      and send you its id and secret. Faster, and you are trusting a
#      secret that other villages also hold.
#
# The callback address you register must be exactly:
#   <your FRONTEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only if your callback lives somewhere other than FRONTEND_URL. Leave blank
# and it is built from FRONTEND_URL, which is right for almost every village.
GOOGLE_REDIRECT_URI=

# ── WHO FOUNDS THIS VILLAGE ──
#
# Comma separated addresses that get the founder role when they sign in with
# Google. Signing in is not the same as being able to do anything: a founder
# who lands as an ordinary member cannot even name their village, and from
# their side that is indistinguishable from being locked out.
#
# It is applied on EVERY matching sign-in, not once, so a role lost to a
# restore from backup or a hand-edit comes back by signing in again. No shell,
# no shared password.
#
# Two things it deliberately will not do. It only ever raises a role, so
# deleting a line here cannot demote a working founder or lock a village out of
# itself; demotion is a deliberate act on the admin surface. And it applies
# only to an address Google verified, so nobody can claim a founder's address
# at Google and collect the role with it.
#
# Blank means nobody, which is the right default. It never means anyone.
FOUNDER_EMAILS=

# ── PAYMENTS: only needed if this village will sell anything with a card ──

# Your Stripe secret key (sk_live_... or sk_test_...) from your own Stripe
# account. Settable from Admin, Integrations instead of here. Without it,
# card checkout answers an honest 503 and the manual-payment path still
# grants credits.
STRIPE_SECRET_KEY=

# The signing secret for the ONE webhook endpoint this platform uses:
# POST /api/webhooks/stripe. Create the endpoint in your Stripe dashboard
# (Developers, Webhooks) pointing at https://<your-domain>/api/webhooks/stripe,
# subscribe it to checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.paid, charge.refunded and charge.dispute.created, then paste its
# signing secret here. Settable from Admin, Integrations instead, which also
# shows you the exact URL to paste into Stripe. Without it, settlements are
# unverified or rejected and orders never credit.
STRIPE_WEBHOOK_SECRET=

# ── AI ASSISTANT (Maia): optional, the assistant simply hides without it ──

# Your own Anthropic API key. Powers guided proposals, the launch guide, the
# map concierge and call synthesis. Settable from Admin, Integrations
# instead of here. Without it, the assistant hides; every form and the rest
# of the platform keep working.
ANTHROPIC_API_KEY=

# Points the assistant at a stub instead of api.anthropic.com. Development
# and CI only. Leave this unset in production.
ANTHROPIC_BASE_URL=

# A ReGen-provisioned key this deployment may borrow until the village adds
# its own. Set only by whoever operates the ReGen-hosted deployment; leave
# unset on a self-hosted instance. There is deliberately no admin toggle
# for this one. Without it, no borrowing happens; the assistant is simply
# unavailable until the village adds its own key.
PLATFORM_ASSISTANT_KEY=

# Calls per day allowed against the borrowed key above. 0 means zero, never
# unlimited. Only meaningful alongside PLATFORM_ASSISTANT_KEY.
PLATFORM_ASSISTANT_DAILY_CAP=

# ── PER-MODULE INTEGRATIONS: optional, each module hides or 503s cleanly without its key ──

# Shared secret for POST /api/webhooks/riverside (the automation module).
# Settable from Admin, Integrations instead of here. This webhook fails
# closed: without a matching secret, every delivery is discarded with an
# inert 200, and the automation admin card shows a warning while it is
# unset.
RIVERSIDE_WEBHOOK_SECRET=

# Shared secret for POST /api/webhooks/mechanics-governance, how a Hypha
# vote's outcome comes home. Settable from Admin, Integrations instead of
# here. Fails closed: unset or mismatched means every delivery is discarded
# with an inert 200, and a human still applies verified outcomes by hand
# from the proposal card.
GOVERNANCE_HUB_SECRET=

# 32 bytes of hex, minimum. Verifies deliveries to the Hypha voice-claim
# receiver, which lets a member claim voice tokens earned here on Hypha.
# Only needed once you set the `economy.hypha_space` game variable from
# Admin; without it while that variable is set, every claim delivery is
# refused with a clear log line rather than accepted unsecured. Must not
# reuse GOVERNANCE_HUB_SECRET, STRIPE_WEBHOOK_SECRET or any other secret in
# this file; the server refuses to boot if it does.
HYPHA_VOICE_WEBHOOK_SECRET=

# ── SATELLITE IMAGERY FOR THE LIVING MAP: optional, the map says so when unset ──
#
# Which imagery source the land pages fetch aerial photographs from. There is
# no default and no silent fallback, on purpose: a map quietly showing a
# different picture from the one you configured is worse than a map saying
# nothing is configured. Unset, the land page shows an honest empty state.
#
# Pick exactly ONE of these five ids, then set that provider's key below:
#
#   village-upload  Your own aerial photograph, uploaded through Admin. No key,
#                   no third-party licence, no account. Start here.
#   sentinel2       Copernicus Sentinel-2, 10 m resolution, free and open,
#                   redistributable. Needs SENTINEL_WMS_URL.
#   mapbox          Mapbox Static Images, 0.5 m. Needs MAPBOX_TOKEN. Mapbox's
#                   terms forbid serving their imagery from a cache, so this
#                   platform refetches rather than storing a copy.
#   google          Google Maps Static. Needs GOOGLE_MAPS_STATIC_KEY. Same
#                   no-caching rule as Mapbox.
#   esri            Esri World Imagery, 0.5 m. Needs ESRI_API_KEY. The standard
#                   layer is not licensed for holding tiles offline.
SATELLITE_PROVIDER=

# A WMS base URL that serves Sentinel-2 TRUE_COLOR. Only read when
# SATELLITE_PROVIDER=sentinel2. No host is named here because every keyless
# route to Sentinel-2 is a WMS somebody else operates, and hardcoding one
# would point every village at a server this project does not run.
SENTINEL_WMS_URL=

# Your own Mapbox access token. Only read when SATELLITE_PROVIDER=mapbox.
MAPBOX_TOKEN=

# Your own Google Maps Static API key. Only read when SATELLITE_PROVIDER=google.
GOOGLE_MAPS_STATIC_KEY=

# Your own Esri API key. Only read when SATELLITE_PROVIDER=esri. Esri also
# answers without a token at a lower tier, so this one is optional even for
# that provider.
ESRI_API_KEY=

# ── BACKUPS ──

# Authenticates GET /api/admin/backup/uploads-archive, which is how the
# scheduled backup workflow pulls a copy of the uploads volume. This route is
# gated by this token and NOT by an admin session, so without it the route
# answers 503 and your member uploads are not in any backup, while the
# database dump keeps running and looks fine. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value as the backup workflow's own secret. See ops/ for the
# workflow side.
BACKUP_EXPORT_TOKEN=

# ── SELF-HOSTED HYPHA LISTENER: a SEPARATE process, not this server ──
#
# Most villages never touch this section. The ReGen hub runs one Base listener
# on behalf of every fork, and GOVERNANCE_HUB_SECRET above is how its outcomes
# come home. These are only for a village that would rather run its own
# listener process (server/lib/hypha/selfHostedListener.ts) instead of trusting
# the shared one. THIS SERVER READS NONE OF THEM: nothing in the web process
# imports that module, so setting them here changes nothing about your village
# until you actually start that second process with them.
#
# They are listed anyway because the alternative is a founder discovering them
# by reading source, which is the failure this whole file exists to prevent.
# The loader refuses to start on the first missing or malformed one and names
# it, so this list is discoverable the hard way too; it should not have to be.

# The governance contract on Base to watch. Required; the listener refuses to
# start without it, naming it.
HYPHA_LISTENER_CONTRACT_ADDRESS=

# A Base JSON-RPC endpoint to read logs from. Required, same refusal.
HYPHA_LISTENER_RPC_URL=

# Where the listener POSTs an outcome it has seen. Must be https and publicly
# resolvable; a private or plain-http address is refused at startup.
HYPHA_LISTENER_WEBHOOK_URL=

# The secret the listener signs those deliveries with. Set the receiving side
# to the same value.
HYPHA_LISTENER_WEBHOOK_SECRET=

# The Base block to start from on a genuinely first run, before any checkpoint
# file exists. Set it to the block your Hypha space started using the contract,
# or to the current head to watch only from now on. Without it the listener
# refuses to start rather than attempting a scan from genesis, which no Base
# RPC serves cheaply. After the first successful poll the checkpoint takes over
# and this is ignored.
HYPHA_LISTENER_START_BLOCK=

# Where the listener's own files live. Defaults to DATA_DIR, or ./data when
# DATA_DIR is unset too. Set it only if they need to live elsewhere.
HYPHA_LISTENER_DATA_DIR=

# The topic0 hashes of the two events the listener watches for. At least ONE
# of the pair is required: with neither set the listener refuses to start,
# because it would otherwise poll forever and deliver nothing.
HYPHA_LISTENER_PASSED_TOPIC0=
HYPHA_LISTENER_FAILED_TOPIC0=

# Which indexed topic of the event carries the agreement id, 0 to 3. Leave
# blank unless your contract puts it somewhere other than where the decoder
# expects; a value outside 0 to 3 refuses to start.
HYPHA_LISTENER_AGREEMENT_ID_TOPIC_INDEX=

# Your Hypha space id, if outcomes should be tagged with it. Optional.
HYPHA_LISTENER_SPACE_ID=

# How many block confirmations to wait before treating a log as final, how
# often to poll in milliseconds, and how many delivery attempts before a
# payload goes to the dead-letter file. All optional; the listener's own
# defaults are right for Base.
HYPHA_LISTENER_CONFIRMATIONS=
HYPHA_LISTENER_POLL_INTERVAL_MS=
HYPHA_LISTENER_MAX_ATTEMPTS=

# Exact paths for the scan checkpoint and the dead-letter file, if you want
# them somewhere other than under HYPHA_LISTENER_DATA_DIR. Optional.
HYPHA_LISTENER_CHECKPOINT_PATH=
HYPHA_LISTENER_DEADLETTER_PATH=

# ── MORE OPTIONAL INTEGRATIONS: each one hides or degrades honestly ──

# An Etherscan/Basescan API key (one free key from etherscan.io serves Base
# too) for Admin, Game Mechanics, Integrate DAO's token-address lookup.
# Settable from Admin, Integrations instead of here. Without it, that one
# lookup answers 409 with guidance; addresses can still be pasted by hand.
BASESCAN_API_KEY=

# Where member feedback gets relayed, if you want it to leave this village
# at all. Must be https:// and publicly resolvable. There is no default on
# purpose: without it, the relay does not run and everything stays local in
# Admin, Feedback, which is the safer starting state.
FEEDBACK_HUB_URL=

# An HTTPS endpoint (a Slack or Discord incoming webhook, a Sentry URL, your
# own collector) that receives a JSON alert when something crashes. Admins
# are always notified inside the app regardless. Without it, crashes are
# still logged and still alert admins in-app; nothing reaches an outside
# channel too.
ERROR_WEBHOOK_URL=

# Where a village is sent when the platform itself is the support desk for
# an Included module, or a lapsed Managed listing. Without it, the lapse
# message still says what keeps working, it just names nowhere to write.
PLATFORM_SUPPORT_URL=

# Same as above, as an email address, used when PLATFORM_SUPPORT_URL is unset.
PLATFORM_SUPPORT_EMAIL=

# ── DOCKER COMPOSE: only when you run docker-compose.yml on one machine ──
#
# The compose file reads these to start its own MySQL and to publish the app.
# `node scripts/fork-init.mjs --compose` fills all of them in and points
# DATABASE_URL at the compose database (mysql://village:...@db:3306/village).
# A hosted deployment (Railway and the like) leaves them blank.

# The password of the `village` database user, and of MySQL's root user.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# The port on this computer the village answers on. Blank means 3000.
VILLAGE_PORT=

# The image to run. Blank means the release this file came with. Pin a
# version (ghcr.io/rieki777/village-os:1.2.0); never run :edge for a village.
VILLAGE_OS_IMAGE=

# ── LOCAL DEVELOPMENT AND TESTING ONLY: never set these on a real deployment ──

# A scratch MySQL connection string for the automated test suite. The test
# harness creates and drops its own uniquely-named schemas here; never
# point it at your real database.
#
# TRAP, verified twice. Without it, roughly a third of the suite skips itself:
# 91 files and 1,190 tests, measured 2026-09-02. Until that date `pnpm test`
# also EXITED 0 in that state, which is a green nobody can tell apart from a
# real one. A whole run with this unset now fails instead.
#
# It ships COMMENTED OUT rather than empty, and rather than live. Empty was a
# trap: `cp .env.example .env` produced the silent-skip state directly, and
# the warning about it sat in this comment, which you only read once you
# already suspect the problem. A live value would be a worse trap in the
# other direction: it would point every first checkout at a MySQL that is
# probably not there.
#
# This comment used to argue that failing a first run was also wrong, because
# "a red that everybody learns to ignore is permanently worse than a green
# that some people over-trust". That is true of a red you cannot clear. This
# one you clear once, with either line below, and never see again. What it
# will not do is let a run that skipped a third of itself report success.
#
# The line below is the value CI uses, and it works unchanged against a local
# `docker run -e MYSQL_ROOT_PASSWORD=ci-test -p 3306:3306 mysql:8`.
# TEST_DATABASE_URL=mysql://root:ci-test@127.0.0.1:3306/mysql

# No MySQL, and you want the smaller suite anyway. This is the documented
# "a database is optional to start" path from CONTRIBUTING.md: uncomment it
# and `pnpm test` goes green again with 91 files skipped, saying so after the
# summary. Read the skip count as the result, because that run proves nothing
# about the ledger, the economy, or any route.
#
# It does NOT silence `pnpm test:full` or CI. Those two say the database is
# mandatory for that run, and a waiver sitting in a file must not be able to
# override a demand made on purpose.
# ALLOW_NO_TEST_DB=1

# Points the Google sign-in token exchange at a local stand-in instead of
# Google. Development and CI only, and the server enforces that: a value that
# is not an http loopback address is logged and ignored, and the real Google
# endpoint is used anyway. Leave this unset in production.
GOOGLE_TOKEN_ENDPOINT=

# Overrides where uploaded files are stored. On Railway this is set for you
# by the volume mount at /app/data; you do not need to set it yourself.
DATA_DIR=

# The port the server listens on. Railway sets this for you automatically.
# Only useful for local development, where it defaults to 3000 if unset.
PORT=

# ── NOT YET MEANINGFUL: named so it is not mistaken for a missing step ──

# Opens POST /api/agent/v1/intents. The code it depends on (the introductions
# module) has not landed, so this stays unset on every deployment, including
# yours, until FORK_RUNBOOK.md says otherwise. It sat under STRONGLY
# RECOMMENDED until 2026-09-02, which put a variable nobody should set at the
# top of every new founder's list of next steps.
AGENT_INTENT_WRITE=

# ── SAFETY VALVES: correct unset, listed so nobody has to guess ──

# Turns the background scheduler OFF when set to 0, off, false or no. UNSET
# MEANS ON, which is what you want. A village that sets this by accident is a
# village whose loans never settle, whose cycles never close and whose digests
# never send, with nothing visibly broken; the only signal is one line in the
# boot log saying NOT STARTED and naming this variable. Leave it blank.
SCHEDULER_ENABLED=

# How long, in milliseconds, to let in-flight requests finish before the
# process exits on a restart. The built-in default is right for Railway.
SHUTDOWN_DRAIN_MS=

# The shortest gap between two recomputes of the uploads-volume size gauge, in
# milliseconds. Defaults to 1000. Raise it only if that measurement is showing
# up in your own profiling.
UPLOADS_GAUGE_MIN_INTERVAL_MS=

# NOTE: these are read by the code but are set BY the platform or the test
# harness, never by a founder, so they have no line of their own above:
# `NODE_ENV` and `CI` (set by your host and by CI), `ALLOW_STALE_DIST` (a
# build-check escape hatch), and `TEST_SCHEMA` plus `REQUIRE_TEST_DB` (owned by
# the test harness alongside TEST_DATABASE_URL), and `VILLAGE_TEST_RUN_ID`
# (the vitest globalSetup assigns it before any worker starts, to name that
# run's provisioning ledger), and `RESEND_API_BASE` (the test suites point the
# post office at a fake email provider with it, so no test sends real mail).
#
# `JWT_SECRET` and `SESSION_SECRET` are read too, and are deliberately NOT
# settings. The voice-claim wiring reads them only to refuse a
# HYPHA_VOICE_WEBHOOK_SECRET that is a copy of one of them. Setting either here
# would do nothing except make that reuse check reject a value that was fine.
#
# `node
# scripts/fork-env-audit.mjs` knows about this list, so it can tell a genuinely
# undocumented variable apart from one that is deliberately not a setting.
#
# NOTE: `GEMINI_API_KEY` is a real variable, but it belongs to a one-off,
# run-by-hand art tool (`scripts/gen_avatars.py`), never to the server. Pass
# it inline on the command line when you use that script; do not put it here.
#
# NOTE: `JOURNEY_PASSWORD` shows up in older notes. It gated a screen that
# was retired; setting it now does nothing.
#
# NOTE: individual paid modules (the module library's "Connected" tier) can
# each add their own environment-variable fallback for their own credential,
# named after the module. None ship one today, so none are listed above.
# If you turn one on later, Admin, Integrations names the exact variable
# for that module's key, live, so this file cannot go stale on that count.
