{
  "image": "ghcr.io/regen-civics/village-os",
  "maxPinDays": 30,
  "paging": {
    "webhookUrl": null
  },
  "rings": [
    { "name": "staging", "order": 0, "description": "Not a real founder. Exists only to catch a broken image before any founder sees it." },
    { "name": "canary", "order": 1, "description": "Two or three real founder instances whose stewards agreed to go first." },
    { "name": "wave-1", "order": 2, "description": "First batch of the remaining regen-hosted founders." },
    { "name": "wave-2", "order": 3, "description": "Second batch. Everyone left who is regen-hosted and unpinned." }
  ],
  "villages": [
    {
      "id": "staging",
      "name": "Staging",
      "hosting": "regen",
      "ring": "staging",
      "domain": "staging.village-os.example",
      "healthUrl": "https://staging.village-os.example/health",
      "steward": { "name": "Platform team", "contact": "platform@example.org" },
      "deploy": {
        "platform": "railway",
        "stopCommand": "echo FILL_IN_stopCommand for staging on {{TAG}}",
        "startCommand": "echo FILL_IN_startCommand for staging on {{TAG}}"
      },
      "pin": null
    },
